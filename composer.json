{
  "name": "pirulug/crud-generator",
  "description": "Laravel CRUD Generator",
  "license": "MIT",
  "authors": [
    {
      "name": "pirulug"
    }
  ],
  "keywords": [
    "laravel",
    "crud",
    "crud generator",
    "laravel crud generator",
    "laravel package",
    "bootstrap css",
    "tailwind css",
    "alpine js",
    "livewire"
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.30|^11.44|^12.2"
  },
  "autoload": {
    "psr-4": {
      "Pirulug\\CrudGenerator\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pirulug\\CrudGenerator\\CrudServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
