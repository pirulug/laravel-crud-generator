{
  "name": "pirulug/crud-generator",
  "description": "Laravel CRUD Generator",
  "license": "MIT",
  "authors": [
    {
      "name": "pirulug"
    }
  ],
  "keywords": [
    "laravel",
    "crud",
    "crud generator",
    "laravel crud generator",
    "laravel package",
    "bootstrap css",
    "tailwind css",
    "alpine js",
    "livewire"
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Pirulug\\CrudGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pirulug\\CrudGenerator\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pirulug\\CrudGenerator\\CrudServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
